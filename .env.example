# Copy to .env (docker compose reads it). Secrets do NOT go here: run ./scripts/init-secrets.sh instead.

# ---- Production (default) ---------------------------------------------------
# Exact https origin(s) of the browser app, comma separated, no trailing slash.
CORS_ORIGINS=https://wirepulse.example.com
# OIDC provider. Both are required in production; the API refuses to start without them.
OIDC_ISSUER=https://id.example.com/realms/wirepulse
OIDC_AUDIENCE=wirepulse-api
# OIDC_JWKS_URI=            # only if the issuer does not publish /.well-known/openid-configuration
# Browser sign-in ("Sign in with SSO" in the console): the client id of a PUBLIC client at your provider (authorization code with PKCE, no secret).
# Without it the console asks for a pasted token instead. OIDC_SCOPES defaults to "openid email profile"; set OIDC_AUTHORIZE_AUDIENCE=true for
# providers (Auth0) that only issue tokens for this API when the authorization request names the audience.
# OIDC_CLIENT_ID=
# OIDC_SCOPES=openid email profile
# OIDC_AUTHORIZE_AUDIENCE=false
# Number of reverse-proxy hops in front of the API (so rate limits and audit see the real client IP).
TRUST_PROXY=1

# Port published on 127.0.0.1 for the reverse proxy.
API_PORT=8080
LOG_LEVEL=info

# Optional: bearer token (>= 24 chars) required to scrape /metrics. Without it /metrics is hidden in production.
# METRICS_TOKEN=

# Optional data retention in days (0 = keep forever). Deletion is irreversible: decide with your compliance owner.
# Audit retention removes only the oldest contiguous part of each workspace's hash chain, and every purge is itself audited.
# RETENTION_DAYS_JOBS=0
# RETENTION_DAYS_REPORTS=0
# RETENTION_DAYS_AUDIT=0

# ---- Optional: scale, SaaS and integrations (all off or defaulted when empty; see DEPLOYMENT.md) ----------
# Failed authentications per IP per minute before that IP is refused entirely (behind a shared NAT one broken client affects its neighbours).
# AUTH_FAILURE_LIMIT_PER_MINUTE=30
# Connections per API instance. Keep replicas x (DB_POOL_SIZE + 1) below PostgreSQL max_connections.
# DB_POOL_SIZE=10
# Row-level security: request handlers run as a database role confined to the caller's workspace (a second barrier behind the code's own checks).
# On by default. Turn off only where the migrating user cannot create roles (see DEPLOYMENT.md).
# DB_ROW_LEVEL_SECURITY=true
# Live event streams one workspace may hold open on one replica (the instance-wide cap is SSE_MAX_CLIENTS).
# SSE_MAX_CLIENTS_PER_WORKSPACE=100
# Shared rate limits across replicas (docker-compose.scale.yml sets this for its own Redis). Counters only; losing Redis is harmless.
# REDIS_URL=redis://redis:6379
# Plan for new workspaces: free | team | business | enterprise (enterprise = no limits, the right choice for one organisation).
# DEFAULT_PLAN=enterprise
# Live workspaces one person may create (0 = no cap) and how long a deleted workspace can still be restored.
# MAX_WORKSPACES_PER_USER=0
# WORKSPACE_PURGE_GRACE_DAYS=30
# Verify and log each workspace's audit chain head every N minutes (0 = off). Ship the logs somewhere the database admins cannot edit.
# AUDIT_ANCHOR_INTERVAL_MINUTES=15
# Invitation email. smtp:// must upgrade with STARTTLS, smtps:// uses TLS from the start. SMTP_URL carries credentials: prefer SMTP_URL_FILE.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=WirePulse <no-reply@example.com>
# INVITE_BASE_URL=https://wirepulse.example.com
# Webhooks: set a random secret of at least 32 characters to turn them on (prefer WEBHOOK_SIGNING_KEY_FILE). Keep it with your backups:
# every webhook secret is derived from it. Private ranges a webhook may reach, comma separated (public addresses need no entry).
# WEBHOOK_SIGNING_KEY=
# WEBHOOK_ALLOWED_CIDRS=
# Days to keep delivered or failed outbox messages.
# OUTBOX_RETENTION_DAYS=14

# ---- Local trial only: never use these in production ------------------------
# NODE_ENV=development
# DEV_BEARER_TOKEN=development-only-token
# DEV_SUBJECT=dev-admin
# DEV_EMAIL=admin@wirepulse.local
# CORS_ORIGINS=http://localhost:5173
